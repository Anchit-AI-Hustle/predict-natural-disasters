<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Use my location": asked only when the person taps it; never at launch. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Alerts for saved places, asked for only when alerts are turned on (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pnd"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App links for the website's record routes. Verification needs
                 /.well-known/assetlinks.json on the site (see android/README.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="predict-natural-disasters.anchit-tandon.com" />
                <data android:pathPrefix="/disasters/" />
                <data android:pathPrefix="/alerts/" />
                <data android:pathPrefix="/calamities/" />
                <data android:pathPrefix="/forecasts/" />
                <data android:pathPrefix="/regions/" />
                <data android:pathPrefix="/locations/" />
                <data android:pathPrefix="/hazards/" />
                <data android:pathPrefix="/history/" />
                <data android:pathPrefix="/sources/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
