{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/portal.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(disasters|alerts|forecasts|calamities|regions|locations|hazards|history|sources)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)-detail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/disasters/:id",
      "destination": "/event-detail?id=:id"
    },
    {
      "source": "/calamities/:id",
      "destination": "/calamity-detail?id=:id"
    },
    {
      "source": "/alerts/:id",
      "destination": "/alert-detail?id=:id"
    },
    {
      "source": "/forecasts/:id",
      "destination": "/forecast-detail?id=:id"
    },
    {
      "source": "/regions/:region",
      "destination": "/region-detail?region=:region"
    },
    {
      "source": "/locations/:location",
      "destination": "/location-detail?location=:location"
    },
    {
      "source": "/hazards/:type",
      "destination": "/hazard-detail?type=:type"
    },
    {
      "source": "/history/:id",
      "destination": "/historical-event-detail?id=:id"
    },
    {
      "source": "/sources/:source",
      "destination": "/source-detail?source=:source"
    },
    {
      "source": "/insight-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/methodology-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/metric-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/resource-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/about-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/calendar-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/comparison-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/notification-detail",
      "destination": "/entity-detail"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[ledger\\]' && exit 0 || exit 1"
}
