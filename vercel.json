{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/portal.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(disasters|alerts|forecasts|calamities|regions|locations|hazards|history|sources)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)-detail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/disasters/:id",
      "destination": "/event-detail.html?id=:id"
    },
    {
      "source": "/calamities/:id",
      "destination": "/calamity-detail.html?id=:id"
    },
    {
      "source": "/alerts/:id",
      "destination": "/alert-detail.html?id=:id"
    },
    {
      "source": "/forecasts/:id",
      "destination": "/forecast-detail.html?id=:id"
    },
    {
      "source": "/regions/:region",
      "destination": "/region-detail.html?region=:region"
    },
    {
      "source": "/locations/:location",
      "destination": "/location-detail.html?location=:location"
    },
    {
      "source": "/hazards/:type",
      "destination": "/hazard-detail.html?type=:type"
    },
    {
      "source": "/history/:id",
      "destination": "/historical-event-detail.html?id=:id"
    },
    {
      "source": "/sources/:source",
      "destination": "/source-detail.html?source=:source"
    },
    {
      "source": "/calamities",
      "destination": "/calamities.html"
    },
    {
      "source": "/event-detail",
      "destination": "/event-detail.html"
    },
    {
      "source": "/calamity-detail",
      "destination": "/calamity-detail.html"
    },
    {
