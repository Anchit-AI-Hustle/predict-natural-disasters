      "destination": "/region-detail.html"
    },
    {
      "source": "/location-detail",
      "destination": "/location-detail.html"
    },
    {
      "source": "/hazard-detail",
      "destination": "/hazard-detail.html"
    },
    {
      "source": "/historical-event-detail",
      "destination": "/historical-event-detail.html"
    },
    {
