{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/portal.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(alert-rules|alerts-client|backtest-view|collection|continents|country-names|event-enrichment|forecast-models|forecast-table|globe|glossary|hazard-model|history-data|map-setup|observed-model|place-risk|place-search|risk|search|trust|verdicts|verification-model)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(app-pages|risk|portal)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(disasters|alerts|forecasts|calamities|regions|locations|hazards|history|sources)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)-detail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(vendor|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(world-countries.json|og-image.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-v3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/live-map",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/live-map",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/disasters/:id",
      "destination": "/event-detail?id=:id"
    },
    {
      "source": "/calamities/:id",
      "destination": "/calamity-detail?id=:id"
    },
    {
      "source": "/alerts/:id",
      "destination": "/alert-detail?id=:id"
    },
    {
      "source": "/forecasts/:id",
      "destination": "/forecast-detail?id=:id"
    },
    {
      "source": "/regions/:region",
      "destination": "/region-detail?region=:region"
    },
    {
      "source": "/locations/:location",
      "destination": "/location-detail?location=:location"
    },
    {
      "source": "/hazards/:type",
      "destination": "/hazard-detail?type=:type"
    },
    {
      "source": "/history/:id",
      "destination": "/historical-event-detail?id=:id"
    },
    {
      "source": "/sources/:source",
      "destination": "/source-detail?source=:source"
    },
    {
      "source": "/insight-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/methodology-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/metric-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/resource-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/about-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/calendar-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/comparison-detail",
      "destination": "/entity-detail"
    },
    {
      "source": "/notification-detail",
      "destination": "/entity-detail"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[ledger\\]' && exit 0 || exit 1",
  "functions": {
    "api/alerts-run.js": {
      "maxDuration": 60
    },
    "api/events.js": {
      "maxDuration": 15
    }
  }
}
